@model List<LogicLayer.Models.MovieToWatch>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Netflix-Style UI (Placeholder)</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css">
</head>
<body>
    <header>
        <h1>List</h1>
        <nav class="nav-links">
           <a href="@Url.Action("Index", "MovieHome")">Home</a>

        </nav>

    </header>

    <main>
        <section class="movie-section">
            <h2>Mijn Movies</h2>
            <div class="movie-row">
                @if (Model != null && Model.Any())
                {

                    foreach (var movie in Model)
                    {

                        <a class="movie" href="@Url.Action("Details", "MovieHome", new { id = movie.MovieId })">
                            @movie.MovieName
                        </a>

                    }

                }
            </div>


        </section>

    </main>

    <footer>
        <p>© 2025 MovieWatch-List</p>
    </footer>
</body>
</html>