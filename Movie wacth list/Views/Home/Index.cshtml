@model List<LogicLayer.Models.User>

<h2>Users</h2>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>firstName</th>
            <th>lastName</th>
            <th>emailAdress</th>
            <th>Password</th>
            <th>userName</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.firstName</td>
                    <td>@user.lastName</td>
                    <td>@user.emailAdress</td>
                    <td>@user.Password</td>
                    <td>@user.userName</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">No users available</td>
            </tr>
        }
    </tbody>
</table>

