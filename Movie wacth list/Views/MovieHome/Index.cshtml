@model List<LogicLayer.Models.Movie>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Netflix-Style UI (Placeholder)</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css">
</head>
<body>
    <header>
        <h1>Home</h1>
        <nav class="nav-links">
            <a href="#">Home</a>
            <a href="@Url.Action("Index", "UserList")">My List</a>
        </nav>

    </header>

    <main>
        <section class="movie-section">
            <h2>Popular Movies</h2>
            <div class="movie-row">
            @if (Model != null && Model.Any())
            {
             
                foreach (var movie in Model)
                {
                        <a class="movie" asp-controller="MovieHome" asp-action="Details" asp-route-id="@movie.Id">
                            @movie.Name
                        </a>               
                }
                
            }
            </div>


        </section>

    </main>

    <footer>
        <p>© 2025 MovieWatch-List</p>
    </footer>
</body>
</html>
